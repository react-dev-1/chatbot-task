# Copy to .env and fill in. Never commit .env.

# Ingest only: Hugging Face read token with access to lmsys/lmsys-chat-1m
HF_TOKEN=
LMSYS_MAX_PAIRS=20000

# Voyage AI (ingest + server). Model and dimension must match between ingest and server.
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3.5
VOYAGE_DIM=1024

# Anthropic
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT_TEXT=low
CLAUDE_EFFORT_VOICE=low
CLAUDE_MAX_TOKENS=64000

# Retrieval
RAG_TOP_K=4
MIN_SIMILARITY=0.5
LMSYS_DATA_DIR=data

# Vapi (voice)
VAPI_PUBLIC_KEY=
VAPI_ASSISTANT_ID=
VAPI_CUSTOM_LLM_SECRET=
# Public URL Vapi can reach, e.g. your ngrok/cloudflared tunnel
PUBLIC_BASE_URL=

PORT=3000
